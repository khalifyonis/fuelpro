# -----------------------------------------------------------------------------
# FUELPRO - Environment Configuration Example
# -----------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://fuelpro_user:fuelpro_pass@localhost:5432/fuelpro_db?schema=public"

# Backend API
PORT=3001
JWT_SECRET="fuelpro-super-secret-jwt-key-production-change-this-in-prod"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_NAME="FUELPRO"

# System Defaults
DEFAULT_CURRENCY="USD"
DEFAULT_TIMEZONE="UTC"
DEFAULT_LOCALE="en-US"
